   "source": [
    "col = \"capital_run_length_longest\"\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 3.5))\n",
    "train_df[col].plot.hist(bins=50, ax=axes[0], title=f\"{col} (original)\")\n",
    "np.log1p(train_df[col]).plot.hist(bins=50, ax=axes[1], title=f\"log(1 + {col})\")\n",

     "start_time": "2026-10-27T15:06:15.748022Z"
    }
   },
   "source": [
    "train_df, test_df = loader.split(df_clean)\n",
    "loader.save_split(train_df, test_df)\n",
    "\n",
    "print(\"SPLIT VERIFICATION\")\n",
    "print(f\"Train: {train_df.shape}, spam {train_df['is_spam'].mean():.2%}\")\n",
    "print(f\"Test:  {test_df.shape}, spam {test_df['is_spam'].mean():.2%}\")"
   ],
